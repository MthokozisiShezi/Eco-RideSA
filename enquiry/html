<head>

    <title>Enquiry | EcoRide SA</title>
    <link rel="stylesheet" href="css/style.css">
</head>

<body>

    <!-- ===== header and navigation ===== -->
    <header>
        <div class="logo">
            <a href="index.html">EcoRide <span>SA</span></a>
        </div>

        <button id="menu-button" aria-label="Open the menu">Menu</button>

        <nav id="main-nav">
            <a href="index.html">Home</a>
            <a href="about_us.html">About Us</a>
            <a href="scooter_page.html">Scooters</a>
            <a href="pricing.html">Pricing</a>
            <a href="safety_information.html">Safety</a>
            <a href="location.html">Locations & Contact</a>
            <a href="enquiry.html" class="active">Enquiry</a>
        </nav>
    </header>

    <main>

        <section class="page-title">
            <h1>Book or Enquire</h1>
            <p>Fill in the form and we will get back to you.</p>
        </section>

        <section>
            <form action="#" method="post">

                <label for="name">Full name</label>
                <input type="text" id="name" name="name" required>

                <label for="email">Email</label>
                <input type="email" id="email" name="email" required>

                <label for="phone">Phone number</label>
                <input type="tel" id="phone" name="phone">

                <label for="date">Date you want to ride</label>
                <input type="date" id="date" name="date" required>

                <label for="station">Pickup station</label>
                <select id="station" name="station" required>
                    <option value="">Choose a station</option>
                    <option value="randburg">Randburg CBD</option>
                    <option value="cresta">Cresta</option>
                    <option value="uj">UJ Kingsway Campus</option>
                </select>

                <label for="scooter">Scooter type</label>
                <select id="scooter" name="scooter" required>
                    <option value="">Choose a scooter</option>
                    <option value="campus-lite">Campus Lite</option>
                    <option value="city-cruiser">City Cruiser</option>
                    <option value="power-rider">Power Rider</option>
                </select>

                <label for="notes">Anything else we should know?</label>
                <textarea id="notes" name="notes"></textarea>

                <button type="submit" class="button">Send Enquiry</button>
                <p id="form-message"></p>
            </form>
        </section>
    </main>

    <!-- ===== footer ===== -->
    <footer>
        <h3>EcoRide SA</h3>
        <p>Affordable. Convenient. Eco-Friendly.</p>
        <p>Randburg, Gauteng</p>
        <p>&copy; 2026 EcoRide SA</p>
    </footer>

    <script src="js/script.js"></script>
</body>

</html>
